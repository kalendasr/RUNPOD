# Factory-level configuration (not per-project — see templates/*/.env.example
# for generated-project secrets).

# AI provider (packages/ai) — see docs/ai-provider.md
HERMES_AI_OLLAMA_URL="http://127.0.0.1:11434"
HERMES_AI_LOCAL_MODEL="qwen2.5-coder:32b"
HERMES_AI_LOCAL_NUM_CTX="4096"

HERMES_AI_HOSTED_URL="https://api.anthropic.com"
HERMES_AI_HOSTED_API_KEY=""
HERMES_AI_HOSTED_MODEL="claude-sonnet-5"

# GPU pod control (RunPod) — see docs/ai-provider.md
RUNPOD_API_KEY=""
HERMES_AI_GPU_POD_ID=""
HERMES_AI_GPU_HOURLY_RATE="0.22"

# Dashboard (apps/factory-api, apps/control-panel) — see docs/dashboard.md
HERMES_FACTORY_API_PORT="4100"
NEXT_PUBLIC_FACTORY_API_URL="http://localhost:4100"

# Telegram bot (apps/telegram-bot) — see docs/telegram-bot.md
TELEGRAM_BOT_TOKEN=""
# Comma-separated chat IDs. Empty = fail closed, the bot refuses everyone.
TELEGRAM_ALLOWED_CHAT_IDS=""
FACTORY_API_URL="http://localhost:4100"
